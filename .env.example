# BDIC School Management System — configuration template
#
# Copy this file to .env and fill in the blanks:
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
#
# Every line marked "FILL IN" needs a real value before that feature works.
# Lines marked "LEAVE BLANK FOR NOW" are for services the school has not opened
# an account with yet. Leaving them blank is correct and safe: the feature
# writes a draft you can read in the app instead of sending anything.


# ===========================================================================
# Required to start at all
# ===========================================================================

APP_ENV=development
PORT=8080

# --- Database --------------------------------------------------------------
# FILL IN. With Homebrew PostgreSQL on this Mac:
#
#     brew install postgresql@17
#     brew services start postgresql@17
#     createdb bdic
#
# Then the URL below works as written, using your Mac username with no
# password. Check your username with `whoami` and substitute it.
#
#   postgres://<your-mac-username>@localhost:5432/bdic?sslmode=disable
#
# Migrations run automatically when the API starts. There is no separate
# migration command.
DATABASE_URL=postgres://postgres@localhost:5432/bdic?sslmode=disable

# --- Session signing key ---------------------------------------------------
# FILL IN. At least 32 characters. The API refuses to start without it.
# Generate one:
#
#     openssl rand -base64 48
#
# Changing this value signs everybody out, which is exactly what you want if it
# is ever exposed. Use a different value in production from the one used here.
AUTH_SIGNING_KEY=

# How long a sign-in lasts. Ten hours covers a school day and the evening.
TOKEN_TTL_HOURS=10

# --- Browser access --------------------------------------------------------
# Comma-separated list of origins allowed to call this API. No wildcards: these
# responses carry student data. In production this becomes the real domain,
# for example https://bdic.edu.in
CORS_ORIGINS=http://localhost:3000

# The address the public site is served from. Used in links inside notices and
# emails. Must be https:// in production.
PUBLIC_BASE_URL=http://localhost:3000


# ===========================================================================
# First administrator
# ===========================================================================
# Used exactly once, when the users table is empty, to create the first login
# so you can sign in and create everyone else.
#
# The account is created with "must change password" set. After you have signed
# in, changed the password, and created the real Principal account, DELETE these
# two lines. The API refuses to start in production while they are set.
BOOTSTRAP_ADMIN_EMAIL=admin@bdic.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisNow2026
BOOTSTRAP_ADMIN_NAME=BDIC Administrator


# ===========================================================================
# File uploads
# ===========================================================================
# Where uploaded documents and photographs are written locally. Relative paths
# are relative to the backend directory. This folder is git-ignored.
UPLOAD_DIR=./var/uploads

# Maximum size of a single upload, in bytes. 8388608 is 8 MiB, which comfortably
# holds a document photographed on a phone.
MAX_UPLOAD_BYTES=8388608

# --- S3, for deployment only ----------------------------------------------
# LEAVE BLANK FOR NOW. Filled in when the school deploys to AWS, so uploads go
# to S3 instead of the local disk. Until then the local disk is used.
# Region ap-south-1 is Mumbai: closest to Chandauli, and keeps data in India.
S3_BUCKET=
S3_REGION=ap-south-1


# ===========================================================================
# SMS to parents
# ===========================================================================
# LEAVE BLANK FOR NOW.
#
# While these are blank, every message the system would send is written to the
# Outbox as a draft. The school can read exactly what each parent would have
# received. Nothing is sent and nothing is charged.
#
# To switch SMS on, the school needs, in its own name:
#   1. An account with an Indian SMS provider (MSG91, Twilio, Gupshup, Textlocal
#      or similar).
#   2. DLT registration with a telecom operator — mandatory in India for
#      transactional SMS. This gives you the Entity ID and a Sender ID.
#   3. Each message template approved on the DLT platform before it can be sent.
#
# Budget roughly Rs 0.15 to Rs 0.25 per message.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=


# ===========================================================================
# WhatsApp to parents
# ===========================================================================
# LEAVE BLANK FOR NOW. Needs a WhatsApp Business account and message templates
# approved by Meta. Charged per conversation by the provider.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=


# ===========================================================================
# Email
# ===========================================================================
# LEAVE BLANK FOR NOW. Needs email on the school's own domain. Google Workspace
# for Education is free for qualifying schools; otherwise use the hosting
# provider's SMTP or Amazon SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ===========================================================================
# Online fee payment
# ===========================================================================
# LEAVE BLANK FOR NOW.
#
# The fee module works fully for office collection — cash, cheque, and printed
# receipts — without any of this. Only a parent paying online from their phone
# needs a gateway.
#
# To switch it on, the school needs a merchant account with Razorpay, PayU,
# Cashfree or its own bank, in the school's name, with the school's PAN and bank
# account. Expect roughly 2% plus GST on each transaction.
#
# Use the provider's TEST keys while testing. Test keys never move real money.
# PAYMENT_WEBHOOK_SECRET is what verifies that a payment confirmation genuinely
# came from the provider; without it a confirmation cannot be trusted.
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
